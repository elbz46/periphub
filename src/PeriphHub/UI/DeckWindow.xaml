<Window x:Class="PeriphHub.UI.DeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeriphHub Deck" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" SizeToContent="WidthAndHeight" ShowInTaskbar="True" Topmost="True"
        Icon="/Assets/app.ico" ShowActivated="False">
    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DCE6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="12" BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="8,4,8,8" Background="#F2181A20">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="30" Margin="0,0,0,6" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE76B;" ToolTip="Previous page" Click="OnPrevPage" />
                    <TextBlock x:Name="PageName" Foreground="#F0F2F7" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Margin="4,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PageCount" Foreground="#8A90A0" FontSize="11" VerticalAlignment="Center" />
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE76C;" ToolTip="Next page" Click="OnNextPage" />
                </StackPanel>
                <TextBlock x:Name="EditHint" Grid.Column="1" Text="Editing: click to edit · drag to move" Foreground="#FFB94A"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="6,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditBtn" Style="{StaticResource HeaderBtn}" Content="&#xE70F;" ToolTip="Edit buttons" Click="OnEdit" />
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE713;" ToolTip="Deck settings" Click="OnSettings" />
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" />
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE8BB;" ToolTip="Hide (Ctrl+Alt+D brings it back)" Click="OnClose" />
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="Cells" />
        </DockPanel>
    </Border>
</Window>
